<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Ship.Structure</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Ship structural plate BOM/mass rollup, primary structure CadDocument builders, and generic fabrication helpers (DXF polyline write, sheet nest, hull-face unfold).</Description>
    <RootNamespace>Novolis.Ship.Structure</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Cad.Primitives" />
    <ProjectReference Include="..\Novolis.Ship.Primitives\Novolis.Ship.Primitives.csproj" />
  </ItemGroup>
</Project>
